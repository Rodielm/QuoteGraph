# GitHub owner (lowercase) that owns the GHCR packages, e.g. "rodielm"
GHCR_OWNER=your-github-username

# Image tag to deploy — "latest" or a specific short SHA from a workflow run
IMAGE_TAG=latest

# Neo4j
NEO4J_PASSWORD=change-me

# Backend
JWT_SECRET_KEY=change-me-to-a-long-random-string
# JSON array of allowed origins for the deployed frontend
CORS_ORIGINS=["https://your-domain.com"]

# Frontend — public URL the browser will call for the backend API
FRONTEND_API_URL=https://api.your-domain.com
